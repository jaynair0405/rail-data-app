# macOS
.DS_Store

# Python bytecode / cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Build / packaging
*.egg-info/
dist/
build/

# Tooling caches
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# Editors
.vscode/
.idea/

# Sensitive/Generated Data - DO NOT COMMIT
# ==========================================
# Real telemetry CSV files (contain sensitive train data)
*.csv
!base-data/*.csv  # EXCEPT base-data CSVs (reference data is OK)
!**/geo*.csv      # Allow geofence CSVs

# Staff roster files (contain personal info)
mail_staff.csv
cli*.csv

# PyInstaller build artifacts
*.spec.bak
RailDataApp.exe

# User-generated reports
*.pdf
*.xlsx

# Temporary files
*.tmp
*.log
/tmp/
app-data/
