# MySQL Database Configuration
# Copy this file to .env and fill in your actual credentials

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=bbtro
MYSQL_USER=your_username_here
MYSQL_PASSWORD=your_password_here

# SSH Tunnel Details (for local development with remote database)
# Run this in a separate terminal before starting the app:
# ssh -L 3307:localhost:3306 railway@server_ip -N
# Then set MYSQL_PORT=3307 above
